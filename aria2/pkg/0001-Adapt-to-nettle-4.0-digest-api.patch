From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AerynOS Developers <dev@aerynos.com>
Date: Wed, 14 Oct 2026 00:00:00 +0000
Subject: [PATCH] Adapt to nettle 4.0 digest api

nettle 4.0 changed nettle_hash_digest_func from
(ctx, digest_length, digest) to (ctx, digest). Adjust the call
accordingly.

---
 src/LibnettleMessageDigestImpl.cc | 2 +-

diff --git a/src/LibnettleMessageDigestImpl.cc b/src/LibnettleMessageDigestImpl.cc
--- a/src/LibnettleMessageDigestImpl.cc
+++ b/src/LibnettleMessageDigestImpl.cc
@@ -69,7 +69,7 @@ public:
   }
   virtual void digest(unsigned char* md) CXX11_OVERRIDE
   {
-    hash->digest(ctx_.get(), getDigestLength(), md);
+    hash->digest(ctx_.get(), md);
   }
 
 private:

